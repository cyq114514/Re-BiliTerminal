<?xml version="1.0" encoding="utf-8"?>
<!-- 隐私与伪装设置页。三个区块：启动密码锁开关 / 修改密码 / 图标名称伪装开关。 -->
<!-- 补齐标准顶栏：普通二级设置页此前无标题栏，只能靠系统返回键退出（F-03） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="隐私与伪装"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginVertical="3dp"
            android:layout_marginEnd="8dp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="7dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/lock_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="启动密码锁"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.9"
                        android:text="打开后每次启动应用都要先通过计算器界面输入密码。关闭或修改密码都需要先验证现有密码；忘记密码不用清数据：长按假计算器的屏幕打开「计算器设置」，进入「用户协议」点「进入应用」即可直接进入应用，登录状态不受影响"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/change_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                android:layout_marginVertical="@dimen/list_margin_vertical"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设置 / 修改密码"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/change_password_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.9"
                        android:text="未设置"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="7dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/disguise_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="把图标和名称伪装成计算器"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.9"
                        android:text="桌面图标与名称变为「计算器」，点开后是真计算器界面，输入密码按等号进入应用。需要先开启启动密码锁；切换后部分桌面（MIUI/ColorOS 等）图标刷新有延迟；从最近任务切回不会重新上锁。忘记密码时：长按假计算器屏幕 → 「计算器设置」→「用户协议」→ 点「进入应用」，可直接回到应用（作为忘记密码的兜底，无需清数据重登）"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="7dp">

                    <LinearLayout
                        android:id="@+id/tutorial_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="使用说明（伪装后怎么进应用）"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tutorial_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▸"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tutorial_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.9"
                        android:lineSpacingExtra="3dp"
                        android:text="① 点上方「设置 / 修改密码」，设一个 4-12 位纯数字密码\n② 打开「启动密码锁」\n③ 打开「把图标和名称伪装成计算器」，确认后桌面图标变成「计算器」\n④ 点桌面「计算器」：进去是一个能正常算数的计算器\n⑤ 输入密码后按「=」，进入应用\n\n【注意】\n· 部分桌面（MIUI / ColorOS 等）图标刷新有几秒延迟，属正常现象\n· 从最近任务切回不会重新上锁，只有冷启动才验证密码\n· 恢复原图标：点桌面「计算器」→ 输密码进应用 → 设置 → 偏好设置 → 隐私与伪装 → 关掉伪装开关\n· 忘记密码：长按假计算器屏幕打开「计算器设置」→「用户协议」→ 点「进入应用」，可直接进入应用（登录状态不受影响）"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
