<?xml version="1.0" encoding="utf-8"?>
<!-- 计算器的「设置」页：伪装的一部分，配色与计算器本体一致（#FF1B1B1D 深底白字，
     次级文字用计算器预览行的 #FF8E8E93），不用 Material 组件（桌面别名链路可能
     非 AppCompat 主题，见 activity_calculator.xml 注释）。
     对外是「按键震动」与「用户协议」，并写明忘记密码的兜底路径；界面大小调大后
     内容可滚动（ScrollView 包裹，同 AdaptiveDialog 的「弹窗被裁」教训）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1B1B1D"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="计算器设置"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 按键震动：真实生效（CalculatorActivity.onKey 每次按键读取 calc_haptic），
                 保证这个设置页在旁人眼里就是一个普通计算器的设置页 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="按键震动"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/calc_haptic_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="16dp"
                android:background="#33FFFFFF" />

            <TextView
                android:id="@+id/agreement_row"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="用户协议"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <!-- 忘记密码的兜底说明（1.3.2 反馈：用户协议是直接进入应用的兜底通道） -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp"
                android:text="忘记密码：打开「用户协议」，点「进入应用」即可直接进入应用，无需清除数据重新登录。"
                android:textColor="#FF8E8E93"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
