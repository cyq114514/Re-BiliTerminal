<?xml version="1.0" encoding="utf-8"?>
<!-- 计算器的「设置」页：伪装的一部分，配色与计算器本体一致（#FF1B1B1D 深底白字）。
     对外只有「按键震动」与「用户协议」两项，不留任何进入真身的提示（暗门在协议页）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1B1B1D"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="计算器设置"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 按键震动：真实生效（CalculatorActivity.onKey 每次按键读取 calc_haptic），
         保证这个设置页在旁人眼里就是一个普通计算器的设置页 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="按键震动"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/calc_haptic_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/agreement_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="用户协议"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />

</LinearLayout>
