<?xml version="1.0" encoding="utf-8"?>
<!-- 用户协议页：伪装模式忘记密码时的兜底通道。点底部「进入应用」直接进入真身，
     不需要密码、也不需要任何隐藏手势（伪装的隐蔽性靠的是没人会来翻计算器设置）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1B1B1D"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/agreement_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="用户协议"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/agreement_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp" />
    </ScrollView>

    <TextView
        android:id="@+id/enter_app_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/background_calc_key_function"
        android:contentDescription="进入应用"
        android:gravity="center"
        android:text="进入应用"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />

</LinearLayout>
