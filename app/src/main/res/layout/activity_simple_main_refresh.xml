<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/pagename_default"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_down" />
        <!-- marginEnd 给下面的「刷新」按钮留出固定宽度：标题与按钮都用 layout_toStartOf="@id/timeText"
             定位，不给标题留白的话长标题会被按钮压住（标题的截断只按 timeText 的位置计算） -->

        <!-- 一键刷新（与下拉刷新等价 + 列表回顶部）：始终半透明灰卡片，与视频卡片同一套
             card_bg_new / 10dp 圆角 / 描边；加载中不高亮。没注册刷新回调时隐藏，避免死按钮。 -->
        <!-- 听歌模式入口：只在本地缓存页点亮（同 filterBar 的先藏后显模式）。
             把下载目录里的 media 文件灌进音频队列，复用全屏听歌页 -->
        <TextView
            android:id="@+id/local_audio_btn"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btn_refresh"
            android:layout_toLeftOf="@id/btn_refresh"
            android:background="@drawable/sel_refresh_chip"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="听歌"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_audio_queue"
            app:drawableTint="@color/text_gray"
            app:drawableTintMode="src_in" />

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:background="@drawable/sel_refresh_chip"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="@string/refresh"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/icon_refresh"
            app:drawableTint="@color/text_gray"
            app:drawableTintMode="src_in" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 同上：视图按内容定高并整体居中，图标才会跟着文字一起居中 -->
    <TextView
        android:id="@+id/emptyTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:text="啥都木有~"
        android:textAlignment="center"
        android:visibility="gone" />

</RelativeLayout>