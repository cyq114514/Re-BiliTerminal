<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
        android:id="@+id/msg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="40dp" />

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_titlebar_fade">

        <TextView
            android:id="@+id/pageName"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_private_message"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>


    <LinearLayout
        android:id="@+id/layout_input_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- 2×2 功能面板（1.3.2 反馈：四个功能键把输入框挤成细条，改为不用时收起）。
             默认收起，点输入行的 ➕ 展开；滚动隐藏动画作用于外层 box，面板跟着一起藏 -->
        <LinearLayout
            android:id="@+id/layout_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 表情：打开表情面板，选中表情码（如 [dog]）追加进输入框随文本一起发；
                     会话拉取时服务端下发 e_infos 映射，收发双方都能渲染成表情图 -->
                <TextView
                    android:id="@+id/emote_btn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_privatemsg_aux"
                    android:contentDescription="表情"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="表情"
                    android:textColor="@color/textwhite"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/icon_emote" />

                <TextView
                    android:id="@+id/pic_btn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_privatemsg_aux"
                    android:contentDescription="图片"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="图片"
                    android:textColor="@color/textwhite"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/icon_image" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 手动换行：手表输入法多数没有 Enter 键，给一个明确的插入换行入口；
                     不把 Enter 键本身绑定成发送 -->
                <TextView
                    android:id="@+id/newline_btn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_privatemsg_aux"
                    android:contentDescription="换行"
                    android:gravity="center"
                    android:text="↵ 换行"
                    android:textColor="@color/textwhite"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/collapse_btn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_privatemsg_aux"
                    android:contentDescription="收起"
                    android:gravity="center"
                    android:text="收起"
                    android:textColor="@color/textwhite"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/layout_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:paddingBottom="4dp">

            <EditText
                android:id="@+id/msg_input_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_toStartOf="@id/more_btn"
                android:background="@drawable/background_edittext_privatemsg"
                android:hint="@string/hint_private_message"
                android:maxHeight="128dp"
                android:minHeight="38dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:textColorHint="@color/text_hint"
                android:textCursorDrawable="@drawable/cursor_drawable"
                android:textSize="13sp"
                android:inputType="textMultiLine" />

            <!-- ➕：展开/收起上方 2×2 功能面板 -->
            <TextView
                android:id="@+id/more_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_toStartOf="@id/send_btn"
                android:background="@drawable/background_privatemsg_aux"
                android:contentDescription="更多功能"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/textwhite"
                android:textSize="20sp" />

            <!-- 发送是主操作：保留强调色实底，其余按钮一律灰卡（DESIGN.md：强调色留给最重要的按钮） -->
            <ImageButton
                android:id="@+id/send_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/background_privatemsg_send"
                android:src="@drawable/send"
                android:layout_alignParentEnd="true" />

        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
