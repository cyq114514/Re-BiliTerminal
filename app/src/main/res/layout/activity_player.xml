<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:keepScreenOn="true"
    android:theme="@style/Theme.BiliClient"
    tools:context=".activity.player.PlayerActivity">

    <RelativeLayout
        android:id="@+id/videoArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <master.flame.danmaku.ui.widget.DanmakuView
        android:id="@+id/sv_danmaku"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:id="@+id/audio_only_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bgblack"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/audio_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:maxWidth="220dp"
                android:text="听视频模式"
                android:textColor="@color/textwhite"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/audio_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.7"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:maxWidth="220dp"
                android:text="听视频模式，仅播放音频"
                android:textColor="@color/textwhite"
                android:textSize="11sp" />

        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/control_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="bottom">

        <!-- 字幕条：与全站胶囊同一套底，压在视频上仍可读 -->
        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/bottom_text_bar"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="2dp"
            android:alpha="0.9"
            android:background="@drawable/player_pill_bg"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/text_default_subtitle"
            android:textColor="@color/textwhite"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 这两条文字在控制卡片之外、直接压视频：保留 1px 柔和阴影，亮画面下才读得清。
             其余放在卡片内的文字一律不投影。
             包在一个独立容器里：底栏收起时只把 bottom_control 设为 INVISIBLE（保留高度），
             文字条位置不变，不会像 1.4.0 早期那样因锚点 GONE 而跳到别处。 -->
        <RelativeLayout
            android:id="@+id/bottom_text_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottom_control"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/text_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:gravity="start"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/text_default_progress"
                android:textColor="@color/textwhite"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/text_online"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:gravity="end"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/text_default_online"
                android:textAlignment="textEnd"
                android:textColor="@color/textwhite"
                android:textSize="11sp" />
        </RelativeLayout>

        <!-- 顶栏：悬浮卡片（10dp 圆角 + 发丝描边），不再铺整条灰底 -->
        <RelativeLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/player_chrome_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <com.RobinNotBad.BiliClient.ui.widget.MarqueeTextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/clock_layout"
                android:drawableStart="@drawable/arrow_back"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/pagename_player"
                android:textColor="@color/textwhite"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/clock_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.RobinNotBad.BiliClient.ui.widget.TextClock
                    android:id="@+id/player_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:alpha="0.7"
                    android:textColor="@color/textwhite"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:ignore="SmallSp" />

                <TextView
                    android:id="@+id/battery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textColor="@color/textwhite"
                    android:textSize="11sp"
                    tools:ignore="SmallSp" />
            </LinearLayout>
        </RelativeLayout>

        <!--固定宽度的返回热区：返回=点标题本身，而标题宽度=屏宽-clock_layout。
            1.2.9 标题栏加了电量百分比后右侧块变宽，标题（含箭头）的可点范围跟着缩水。
            热区钉在左侧不随右侧宽度变化；电量/时钟区域仍不可点退出（X-41）。

            它是 top 的兄弟而不是 top 的子 View，用固定 32dp 高度 + alignTop 贴在卡片顶。
            旧做法是在 top 里放 0dp 子 View、再由 Java 把 top 高度回写进去——首次测量时
            0dp 子 View 会把 wrap_content 的 top 撑成整屏，回写后锁死，正是 1.3.0
            “控制面板消失”的同一根因。这里不写 match_parent、也不回写高度：热区只在
            控制层显示时可见（见 fadeControls），不会在隐藏态拦住“点画面唤出控制栏”。 -->
        <View
            android:id="@+id/back_hot"
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:layout_alignTop="@+id/top"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true" />

        <!-- 底栏：悬浮卡片；进度条 + 按钮行都在卡片内，随控制层一起淡出 -->
        <LinearLayout
            android:id="@+id/bottom_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/player_chrome_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="4dp">

            <com.RobinNotBad.BiliClient.ui.widget.HighEnergyProgressBar
                android:id="@+id/videoprogress"
                style="@style/Widget.AppCompat.SeekBar"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="@color/bili_pink"
                android:secondaryProgressTint="#66FFFFFF"
                android:thumb="@drawable/player_progress_thumb"
                android:thumbOffset="7dp"
                tools:targetApi="lollipop" />

            <RelativeLayout
                android:id="@+id/bottom_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/button_quality"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:adjustViewBounds="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_menu" />

                    <ImageButton
                        android:id="@+id/button_sound_cut"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:adjustViewBounds="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/soundcut" />

                    <ImageButton
                        android:id="@+id/button_video"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:adjustViewBounds="true"
                        android:background="@drawable/player_play_bg"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/player_icon_play" />

                    <ImageButton
                        android:id="@+id/button_sound_add"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:adjustViewBounds="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/soundadd" />

                    <ImageButton
                        android:id="@+id/button_page_selector"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:adjustViewBounds="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_folder"
                        android:visibility="gone" />
                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/right_control"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottom_control"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/top"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:id="@+id/right_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/player_pill_bg"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/right_second_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="3dp">

                    <ImageButton
                        android:id="@+id/danmaku_send_btn"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="2dp"
                        android:adjustViewBounds="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/send" />

                    <ImageButton
                        android:id="@+id/subtitle_btn"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="2dp"
                        android:adjustViewBounds="true"
                        android:alpha="0.5"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/subtitle_off" />

                    <ImageButton
                        android:id="@+id/loop_btn"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="2dp"
                        android:adjustViewBounds="true"
                        android:alpha="0.5"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/loopoff" />

                    <ImageButton
                        android:id="@+id/audio_only_btn"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="2dp"
                        android:adjustViewBounds="true"
                        android:alpha="0.5"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_play_16"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/auto_next_btn"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="2dp"
                        android:adjustViewBounds="true"
                        android:alpha="0.5"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_auto_next_off"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/viewpoint_btn"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="2dp"
                        android:adjustViewBounds="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_folder"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/jump_time_btn"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="2dp"
                        android:adjustViewBounds="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_jump_time" />

                </LinearLayout>

            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/danmaku_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="4dp"
                    android:adjustViewBounds="true"
                    android:alpha="0.5"
                    android:background="@drawable/player_circle_bg"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/danmakuoff" />

                <ImageButton
                    android:id="@+id/rotate_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="4dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/player_circle_bg"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/rotate" />

                <ImageButton
                    android:id="@+id/menu_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/player_circle_bg"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/morehide" />
            </LinearLayout>

        </LinearLayout>

        <!-- 片头/片尾「手动跳过」按钮：仅当档位为"手动跳过"且当前位于片段区间内时显示。
             另外两个档位不需要 UI：总是跳过/跳过一次自动跳，仅显示只用提示，禁用完全不处理 -->
        <!-- 不能用 MaterialCardView：本页主题 Theme.NoSwipe 的 parent 是 android:Theme.Black，
             非 MaterialComponents 后代，MaterialCardView 构造时直接抛 IllegalArgumentException，
             整个布局 inflate 失败 → 播放页起不来。改用普通 FrameLayout + 形状背景。 -->
        <FrameLayout
            android:id="@+id/clip_skip_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/bottom_control"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/player_chrome_bg"
            android:visibility="gone">
            <!-- marginBottom 留 40dp：下方 text_online（"x人在看"）同样贴 bottom_control 上沿右对齐，
                 只留 12dp 时两者垂直带会重叠约 4dp，卡片声明更靠后、会压住人数数字 -->

            <TextView
                android:id="@+id/clip_skip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="跳过片头"
                android:textColor="@color/textwhite"
                android:textSize="12sp" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_debug"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_above="@+id/left_control"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:adjustViewBounds="true"
            android:background="?android:attr/selectableItemBackground"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_debug"
            android:visibility="gone" />

        <!-- 左侧纵列：快退 / 倍速 / 快进 竖着排。
             原先 ±N 秒按钮跟底部那一排挤在一起，小屏（点读笔、手表）上会被压成竖排、
             只露出半个字，现在它们和倍速共用最左边这一列，宽度管够；
             「显示快进快退按钮」关掉 / 直播 / 听视频模式时两个按钮一起收起。

             必须夹在顶栏与进度文字之间：只写 centerVertical 时这一列按"整个控制层"垂直居中，
             矮屏（控制区 200dp 上下）上列底边正好落到进度条上，+10s 的 34dp 触控区压住
             进度条左端——拖进度时抬手就是误触。below/above 同时写等于"在这两条边界之间居中"，
             底边永远不会越过进度文字；高度再不够由 PlayerActivity.clampSeekColumnHeight() 兜底压缩 -->
        <!-- 高度写 match_parent 和 right_control 同一个套路：below/above 把可用区间算出来，
             gravity="center" 再把三行内容在区间里垂直居中。用 wrap_content 时纵向居中全靠
             RelativeLayout 的 centerVertical 与锚点协商，行为不如 gravity 直观 -->
        <LinearLayout
            android:id="@+id/left_control"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottom_text_bar"
            android:layout_alignParentLeft="true"
            android:layout_below="@+id/top"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/button_seek_back"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/player_side_pill_bg"
                android:gravity="center"
                android:text="-10s"
                android:textColor="@color/textwhite"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_speed"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:background="@drawable/player_side_pill_bg"
                android:gravity="center"
                android:text="x 1.0"
                android:textColor="@color/textwhite"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/button_seek_forward"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/player_side_pill_bg"
                android:gravity="center"
                android:text="+10s"
                android:textColor="@color/textwhite"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/loading_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/circle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/loading_text0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.7"
                android:text="加载中"
                android:textAlignment="center"
                android:textColor="@color/textwhite"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/loading_text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.7"
                android:text="OwO"
                android:textAlignment="center"
                android:textColor="@color/textwhite"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- 倍速面板：scrim + 居中卡片；点卡片外收起（layout_speed 自身仍可点） -->
        <LinearLayout
            android:id="@+id/layout_speed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim_black"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/player_panel_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="倍速调节"
                    android:textAlignment="center"
                    android:textColor="@color/textwhite"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekbar_speed"
                    style="@style/Widget.AppCompat.SeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="false"
                    android:max="7"
                    android:progress="2"
                    android:progressTint="@color/bili_pink"
                    android:thumbTint="@color/bili_pink"
                    tools:targetApi="lollipop" />

                <TextView
                    android:id="@+id/text_newspeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:text="1.0x"
                    android:textAlignment="center"
                    android:textColor="@color/textwhite"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 无极调音：0~100% 的软件增益（长按底部音量按钮打开） -->
        <LinearLayout
            android:id="@+id/layout_volume"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim_black"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/player_panel_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="无极调音"
                    android:textAlignment="center"
                    android:textColor="@color/textwhite"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.7"
                    android:text="软件增益，0~100%"
                    android:textAlignment="center"
                    android:textColor="@color/textwhite"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekbar_volume"
                    style="@style/Widget.AppCompat.SeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/bili_pink"
                    android:thumbTint="@color/bili_pink"
                    tools:targetApi="lollipop" />

                <TextView
                    android:id="@+id/text_newvolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:text="100%"
                    android:textAlignment="center"
                    android:textColor="@color/textwhite"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <TextView
        android:id="@+id/showsound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/player_pill_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="音量：100%"
        android:textColor="@color/textwhite"
        android:textSize="12sp"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_black"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/subtitle_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/player_panel_bg"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/subtitle_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:text="选择字幕"
                android:textColor="@color/textwhite"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/subtitle_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:orientation="horizontal"
                tools:listitem="@layout/cell_subtitle" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/danmaku_send_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/player_panel_bg"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:text="发送弹幕"
                android:textColor="@color/textwhite"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/danmaku_send_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/background_edittext"
                android:hint="发个友善的弹幕见证当下"
                android:maxLength="100"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:singleLine="true"
                android:textColor="@color/textwhite"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />

            <Button
                android:id="@+id/danmaku_send"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/player_accent_chip_bg"
                android:gravity="center"
                android:text="发送"
                android:textAllCaps="false"
                android:textColor="#262626"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_selector_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="72dp"
            android:background="@drawable/player_panel_bg"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/page_selector_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:text="选择分P"
                android:textColor="@color/textwhite"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/page_selector_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:maxHeight="240dp"
                android:orientation="vertical" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/quality_selector_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="72dp"
            android:background="@drawable/player_panel_bg"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/quality_selector_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:text="选择清晰度"
                android:textColor="@color/textwhite"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/quality_selector_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:maxHeight="240dp"
                android:orientation="horizontal" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/viewpoint_selector_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/player_panel_bg"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/viewpoint_selector_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:text="视频分段"
                android:textColor="@color/textwhite"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/viewpoint_selector_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:orientation="horizontal"
                tools:listitem="@layout/cell_episode" />

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>