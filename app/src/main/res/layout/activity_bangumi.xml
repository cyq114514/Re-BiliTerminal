<?xml version="1.0" encoding="utf-8"?>
<!-- 番剧页：顶栏固定，页签与索引筛选栏随列表滚出屏幕（AppBarLayout scroll），
     不再是"焊死在顶部"的两条固定横条 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="番剧"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/bangumiCoordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <!-- 页签 + 筛选栏：作为滚动内容的一部分，列表上滑时整块上移出屏 -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll">

                <!-- 主 Tab（4个：推荐/追番/索引/热门；推荐页可在设置中关闭）
                     胶囊式页签：复用筛选 chip 的选择器，选中粉色底白字并加粗 -->
                <!-- 1.3.3 反馈：界面调大后 4 个页签 + 源入口会挤成一团。
                     包一层 HorizontalScrollView，页签改按内容宽从左往右排，放不下左右滑 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabBar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:gravity="center">
                        <TextView android:id="@+id/tab0" android:layout_width="wrap_content"
                            android:layout_height="30dp" android:gravity="center" android:paddingHorizontal="14dp"
                            android:text="推荐" android:textSize="13sp" android:textStyle="bold"
                            android:textColor="@color/sel_bangumi_tab_text"
                            android:background="@drawable/sel_filter_chip" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:gravity="center">
                        <TextView android:id="@+id/tab1" android:layout_width="wrap_content"
                            android:layout_height="30dp" android:gravity="center" android:paddingHorizontal="14dp"
                            android:text="追番" android:textSize="13sp"
                            android:textColor="@color/sel_bangumi_tab_text"
                            android:background="@drawable/sel_filter_chip" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:gravity="center">
                        <TextView android:id="@+id/tab2" android:layout_width="wrap_content"
                            android:layout_height="30dp" android:gravity="center" android:paddingHorizontal="14dp"
                            android:text="索引" android:textSize="13sp"
                            android:textColor="@color/sel_bangumi_tab_text"
                            android:background="@drawable/sel_filter_chip" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:gravity="center">
                        <TextView android:id="@+id/tab3" android:layout_width="wrap_content"
                            android:layout_height="30dp" android:gravity="center" android:paddingHorizontal="14dp"
                            android:text="热门" android:textSize="13sp"
                            android:textColor="@color/sel_bangumi_tab_text"
                            android:background="@drawable/sel_filter_chip" />
                    </LinearLayout>
                    <!-- 第三方源入口：固定 40dp，不参与 4 个页签的等分。
                         5 个等宽格在 213dp 的手表上每格只剩 42dp，中文标签会溢出 -->
                    <TextView
                        android:id="@+id/sourceEntry"
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:background="@drawable/sel_filter_chip"
                        android:gravity="center"
                        android:text="@string/source_entry"
                        android:textColor="@color/sel_bangumi_tab_text"
                        android:textSize="12sp" />
                </LinearLayout>
                </HorizontalScrollView>

                <!-- 索引筛选栏（动态条件：排序 + 9 组筛选项，默认折叠为 3 行） -->
                <LinearLayout
                    android:id="@+id/filterBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/filterRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="2dp" />

                    <TextView
                        android:id="@+id/filterToggle"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="展开筛选 ▾"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- 内容区（4 页）：交给 CoordinatorLayout 跟随 AppBar 一起滑动 -->
        <FrameLayout
            android:id="@+id/contentArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh0" android:layout_width="match_parent" android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler0"
                    android:layout_width="match_parent" android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh1" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler1"
                    android:layout_width="match_parent" android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh2" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler2"
                    android:layout_width="match_parent" android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh3" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler3"
                    android:layout_width="match_parent" android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- 空态/失败态：4 个 tab 共用一块，列表为空或加载失败时上屏（X-11） -->
            <TextView
                android:id="@+id/emptyTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="啥都木有~"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</RelativeLayout>
