<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/pagename_default"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/listContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top"
        android:orientation="vertical">

        <!-- 列表筛选/排序条：默认隐藏，只有需要的页面（如「稍后再看」的全部/未看完）
             在代码里设成 VISIBLE 并接管点击。放在列表外而不是做成列表项，
             避免改变业务 adapter 的 viewType 与 adapterPosition 语义 -->
        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/activity_padding_horizontal"
            android:paddingRight="@dimen/activity_padding_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="全部"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/filterUnfinished"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="未看完"
                android:textSize="13sp" />

            <!-- 「清除所有已看完」：只有「稍后再看」页会点亮；破坏性操作，点击后二次确认 -->
            <TextView
                android:id="@+id/clearWatched"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="清除已看完"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 列表排序条：默认隐藏，需要服务端排序的页面（如收藏夹的 收藏时间/播放量/投稿时间）
             在代码里点亮。排序要重发请求，和上面的筛选条是两回事 -->
        <LinearLayout
            android:id="@+id/sortBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/activity_padding_horizontal"
            android:paddingRight="@dimen/activity_padding_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/sortByFavTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="收藏时间"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sortByView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="播放量"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sortByPubtime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="投稿时间"
                android:textSize="13sp" />

            <!-- 多选管理入口：只有收藏夹内容页会点亮；破坏性操作，执行前二次确认 -->
            <TextView
                android:id="@+id/manageEntries"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="管理"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.RobinNotBad.BiliClient.ui.widget.RotaryRecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!-- 高度必须 wrap_content：TextView 的 drawableTop 是贴着「视图上沿」画的，
         而文字是按 gravity 居中的——高度撑满父容器时，图标跑到屏幕最顶上（压住标题栏），
         文字却留在中间，看起来就是"图标和文字错位"。让视图自身按内容定高并整体居中即可 -->
    <TextView
        android:id="@+id/emptyTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:text="啥都木有~"
        android:textAlignment="center"
        android:textColor="@color/text_gray"
        android:textSize="13sp"
        app:drawableTopCompat="@drawable/icon_empty"
        app:drawableTint="@color/text_dim"
        app:drawableTintMode="src_in"
        android:drawablePadding="8dp"
        android:visibility="gone" />

</RelativeLayout>