<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/activity_padding_horizontal"
    android:layout_marginVertical="@dimen/list_margin_vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:paddingVertical="14dp"
            android:paddingHorizontal="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.RobinNotBad.BiliClient.ui.widget.RatioImageView
                android:id="@+id/img_cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp"
                android:layout_weight="0.48"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@mipmap/placeholder"
                app:coverRatio="1.6" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:layout_weight="0.52"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:text="标题标题标题标题标题标题标题标题标题标题标题标题标题标题标题标题"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_extra"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:text="11.4M"
                        android:textSize="11sp" />

                    <!-- 纯音频缓存标识：主缓存页不显示音频条目，但二级听歌列表里必须有 -->
                    <TextView
                        android:id="@+id/audio_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_audio_badge"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1dp"
                        android:text="音频"
                        android:textColor="@color/bili_pink"
                        android:textSize="9sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/progress"
            android:layout_width="0px"
            android:layout_height="0dp"
            android:layout_alignTop="@+id/linearLayout"
            android:layout_alignBottom="@id/linearLayout"
            android:alpha="0.3"
            android:background="#74a864"
            android:visibility="gone" />
    </RelativeLayout>


</com.google.android.material.card.MaterialCardView>
