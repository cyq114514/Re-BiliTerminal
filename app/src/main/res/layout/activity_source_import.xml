<?xml version="1.0" encoding="utf-8"?><!--
  订阅导入：地址导入 + 粘贴 JSON 导入。
  两个入口都留着：手表上没有剪贴板管理器方便操作，但地址导入更省事；
  手机上则常常是别人发来一份 JSON，粘贴更直接。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="@string/source_import_title"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="3dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/source_import_desc"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/background_searchbar"
                android:hint="@string/source_import_url_hint"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFetch"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/sel_filter_chip"
                android:gravity="center"
                android:text="@string/source_import_from_url"
                android:textColor="@color/sel_bangumi_tab_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/source_import_paste_title"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/jsonInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/background_searchbar"
                android:gravity="top|start"
                android:hint="@string/source_import_json_hint"
                android:inputType="textMultiLine"
                android:minLines="6"
                android:padding="8dp"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnParse"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/sel_filter_chip"
                android:gravity="center"
                android:text="@string/source_import_parse"
                android:textColor="@color/sel_bangumi_tab_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
