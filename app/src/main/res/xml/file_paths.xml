<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 路径配置。外部播放器打开本地下载视频时会用到。
  默认下载目录是 /sdcard/Android/media/<包名>/，用户还可以在实验室设置里改成任意路径，
  所以 external-path 用 "." 覆盖整个外部存储根；provider 本身 exported=false + 按意图授权，暴露面可控。
-->
<paths>
    <external-files-path
        name="ext_files"
        path="terminal" />
    <external-media-path
        name="ext_media"
        path="terminal" />
    <external-cache-path
        name="ext_cache"
        path="terminal" />
    <external-path
        name="external"
        path="terminal" />
    <external-path
        name="external_all"
        path="." />
    <files-path
        name="files"
        path="terminal" />
    <cache-path
        name="cache"
        path="terminal" />
    <!--应用内更新包：UpdateManager 下载到 cache/update/（externalCacheDir 不可用时退化到内部 cacheDir），
        需要以 content:// 交给系统安装器-->
    <cache-path
        name="update_apk"
        path="update/" />
    <external-cache-path
        name="ext_cache_update"
        path="update/" />
</paths>
