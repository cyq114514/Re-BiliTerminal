<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形按钮底：与视频卡片同一套 token（card_bg_new 半透明灰 / card_border_new 0.5dp
     描边），替代旧渐变描边版与白描边版（1.3.3 反馈迭代：先嫌灰蒙蒙，最终定稿
     与选集卡片、顶栏刷新胶囊统一用视频卡片语言） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/card_bg_new" />
            <stroke
                android:width="@dimen/card_stroke_new"
                android:color="@color/card_border_new" />
        </shape>
    </item>
</layer-list>
