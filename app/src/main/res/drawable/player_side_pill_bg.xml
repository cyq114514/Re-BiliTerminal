<?xml version="1.0" encoding="utf-8"?>
<!--
    播放器左侧 -N秒 / 倍速 / +N秒 专用胶囊底。
    比通用 player_pill_bg 收小一号：按钮 48×30 → 44×28，描边 0.5dp → 0.35dp，
    圆角 14dp → 12dp。左侧三颗按钮必须同尺寸，避免倍速与 ±秒 按钮高低不齐。
    底仍是 player_chrome_bg，压在亮画面上白字可读。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/player_chrome_bg" />
    <stroke
        android:width="0.35dp"
        android:color="@color/card_border_new" />
    <corners android:radius="12dp" />
</shape>