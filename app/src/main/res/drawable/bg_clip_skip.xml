<?xml version="1.0" encoding="utf-8"?>
<!--
    「跳过片头」悬浮按钮的背景。

    原来这里是 MaterialCardView，但 PlayerActivity 的主题是 Theme.NoSwipe
    （parent = android:Theme.Black，不是 MaterialComponents 后代），
    MaterialCardView 构造时会抛：
      IllegalArgumentException: The style on this component requires your app theme
      to be Theme.MaterialComponents (or a descendant)
    → 整个 activity_player.xml inflate 失败，播放页直接起不来。
    这里改成普通形状背景，视觉保持「深色半透明 + 圆角 + 细描边」。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/card_round_new" />
    <solid android:color="#CC1C1C1C" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
